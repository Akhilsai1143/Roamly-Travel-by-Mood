{
  "version": 2,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Security-Policy",
          "value": "upgrade-insecure-requests;"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(self \"https://checkout.razorpay.com\" \"https://api.razorpay.com\"), gyroscope=(self \"https://checkout.razorpay.com\" \"https://api.razorpay.com\"), magnetometer=(self \"https://checkout.razorpay.com\" \"https://api.razorpay.com\")"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
