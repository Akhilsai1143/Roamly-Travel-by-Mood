# ============================================================================
# Roamly Travel — Frontend Environment Configuration
# ============================================================================

# Local Development:
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

# Production Deployment (e.g. Vercel Project Settings > Environment Variables):
# Set this to your live deployed backend URL (Render, Railway, VPS, AWS, etc.):
# VITE_API_URL=https://roamly-backend.onrender.com/api
# VITE_SOCKET_URL=https://roamly-backend.onrender.com
#
# Note: If VITE_API_URL is omitted in production, Roamly automatically defaults
# to "/api" relative path, matching the reverse-proxy rewrite rules in vercel.json.
